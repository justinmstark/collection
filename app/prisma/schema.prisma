generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  hashedPassword String
  role           String           @default("user")
  createdAt      DateTime         @default(now())
  items          CollectionItem[]
}

model Region {
  id        String     @id @default(cuid())
  name      String     @unique
  country   String
  producers Producer[]
}

model Producer {
  id       String    @id @default(cuid())
  name     String
  regionId String?
  region   Region?   @relation(fields: [regionId], references: [id])
  products Product[]
}

model Product {
  id          String           @id @default(cuid())
  name        String
  producerId  String?
  producer    Producer?        @relation(fields: [producerId], references: [id])
  category    String
  subcategory String?
  age         Int?
  abv         Float?
  caskType    String?
  description String?
  imageUrl    String?
  barcode     String?
  smwsCode    String?
  createdAt   DateTime         @default(now())
  items       CollectionItem[]
}

model CollectionItem {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id])
  customName    String?
  quantity      Int          @default(1)
  purchasePrice Float?
  purchaseDate  DateTime?
  openedDate    DateTime?
  status        String       @default("sealed")
  notes         String?
  createdAt     DateTime     @default(now())
  images        ItemImage[]
  valuations    Valuation[]
}

model ItemImage {
  id               String         @id @default(cuid())
  collectionItemId String
  item             CollectionItem @relation(fields: [collectionItemId], references: [id], onDelete: Cascade)
  storageKey       String
  isPrimary        Boolean        @default(false)
  createdAt        DateTime       @default(now())
}

model Valuation {
  id               String         @id @default(cuid())
  collectionItemId String
  item             CollectionItem @relation(fields: [collectionItemId], references: [id], onDelete: Cascade)
  value            Float
  valuedAt         DateTime       @default(now())
  source           String?
}
